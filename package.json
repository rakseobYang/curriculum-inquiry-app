    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.166.0"
  }
}
